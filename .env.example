# MQTT 브로커
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# 스트리밍
STREAM_PORT=8080
STREAM_FPS=12
STREAM_JPEG_QUALITY=70

# 엔진: mediapipe 또는 hailo
GESTURE_ENGINE=mediapipe
HAILO_HEF_PATH=models/gesture.hef

# 카메라
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_ROTATE=true

# 타이밍 (초 단위)
SELECTION_HOLD_SEC=2.0
ONOFF_ENTRY_SEC=0.5
SWITCH_HOLD_SEC=1.5
SWITCH_BUFFER_SEC=1.0
FIVE_H_CONFIRM_SEC=0.4
FIST_HOLD_SEC=1.5
TIMEOUT_SEC=1.5
KNOB_PUBLISH_HZ=10
PROCESS_INTERVAL_SEC=0.1
